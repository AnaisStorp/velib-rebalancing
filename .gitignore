# --- Data: never commit collected snapshots or derived tables, ---
# --- but keep the empty raw/ and processed/ dirs in the tree.   ---
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual envs ---
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# --- Notebooks: keep the .py/.md exploration, not heavy outputs (optional) ---
# (notebooks/ is tracked; strip outputs before committing)

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Models / artifacts (regenerated by the pipeline) ---
*.pkl
*.joblib
